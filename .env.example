# Environment Configuration Example for ProAffluence Backend

# PostgreSQL Database (Docker & Local)
POSTGRES_USER=proaffluence
POSTGRES_PASSWORD=proaffluence_secret
POSTGRES_DB=proaffluence_dev
DATABASE_URL=postgresql://proaffluence:proaffluence_secret@localhost:5433/proaffluence_dev?schema=public

# Application Server
PORT=8002
NODE_ENV=development
TRUST_PROXY=false
SWAGGER_ENABLED=true
# JSON/urlencoded body size (base64 external PDF uploads)
BODY_JSON_LIMIT=35mb

# Redis / BullMQ (Phase 2 jobs). Set JOBS_ENABLED=false for local e2e without Redis.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=
JOBS_ENABLED=true
LIBREOFFICE_CONCURRENCY=1
BENCHMARK_CRON_ENABLED=true

# Better Auth
BETTER_AUTH_SECRET=pRoAfFlUeNcE_sEcReT_kEy_32_bYtEs_mIn_12345
BETTER_AUTH_URL=http://localhost:8002
FRONTEND_ORIGINS=http://localhost:3000

# Cookie & Session Configuration
COOKIE_SAMESITE=lax
SESSION_EXPIRES_IN=1800
SESSION_UPDATE_AGE=300

# Rate Limiting (Sign-in) — Better Auth uses Prisma RateLimit table (database storage)
SIGNIN_RATE_LIMIT_MAX=5
SIGNIN_RATE_LIMIT_WINDOW=60
# Set true when behind a reverse proxy so auth rate limits use the real client IP
# TRUST_PROXY=true

# Benchmark feeds
# NSE archives CSV prefix for Nifty 50 PRICE index only (not TRI).
# TRI / Sensex / BSE 500 require manual entry or a paid source unless TRI is enabled below.
NSE_ARCHIVES_BASE_URL=https://nsearchives.nseindia.com/content/indices/ind_close_all_
# niftyindices.com TRI (default off — live probes often 302 to Sitefinity login).
NIFTYINDICES_TRI_ENABLED=false
NIFTYINDICES_BASE_URL=https://www.niftyindices.com

# Mail / SMTP Configuration (Optional in Dev - falls back to console logger if empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ProAffluence Portal <noreply@proaffluence.com>"
SMTP_SECURE=false
