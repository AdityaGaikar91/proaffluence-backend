{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "setupFiles": ["<rootDir>/jest-e2e.setup.ts"],
  "transform": {
    "^.+\\.(t|j)sx?$": [
      "ts-jest",
      {
        "useESM": false
      }
    ]
  },
  "transformIgnorePatterns": [
    "node_modules/(?!(\\.pnpm|better-auth|@better-auth|better-call)/)"
  ]
}
